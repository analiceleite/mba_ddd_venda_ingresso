### Events
POST {{baseUrl}}/events
Content-Type: application/json

{
  "name": "Show do Foo Fighters",
  "description": "Show na cidade",
  "date": "2026-12-10T20:00:00.000Z",
  "partner_id": "{{partnerId}}"
}

###
GET {{baseUrl}}/events

###
GET {{baseUrl}}/events/{{eventId}}

###
PUT {{baseUrl}}/events/{{eventId}}
Content-Type: application/json

{
  "name": "Show do Foo Fighters 2026",
  "description": "Descrição atualizada",
  "date": "2026-12-11T20:00:00.000Z"
}

###
POST {{baseUrl}}/events/{{eventId}}/publish

###
POST {{baseUrl}}/events/{{eventId}}/unpublish

###
POST {{baseUrl}}/events/{{eventId}}/publish-all

###
POST {{baseUrl}}/events/{{eventId}}/sections
Content-Type: application/json

{
  "name": "Pista",
  "description": "Setor principal",
  "total_spots": 10,
  "price": 150.0
}

### Orders / Reservation + Payment
POST {{baseUrl}}/orders/reserve
Content-Type: application/json

{
  "customer_id": "{{customerId}}",
  "event_id": "{{eventId}}",
  "section_id": "{{sectionId}}",
  "spot_id": "{{spotId}}",
  "payment_method": "pix"
}

###
GET {{baseUrl}}/orders

###
GET {{baseUrl}}/orders/{{orderId}}
