Content-Type: application/json

{
  "name": "John Doe",
  "cpf": "52998224725"
}

###
GET {{baseUrl}}/customers

###
PUT {{baseUrl}}/customers/{{customerId}}
Content-Type: application/json

{
  "name": "John Updated"
}

